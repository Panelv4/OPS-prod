# Native web/worker template. Never put the bootstrap or migration-owner password here.
# Compose uses a separate .env.compose; see ENVIRONMENT_SETUP.md.
DATABASE_URL=postgresql://opspilot_runtime:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/opspilot
OPSPILOT_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
# Explicit flags. Never route customer traffic to a demo DB or a public mail catcher.
TRUST_PROXY=0
BILLING_MODE=off
ENABLE_EXTERNAL_AI=0
# Native local development: private mail sink or approved SMTP relay. Compose supplies its own local sink.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_LOCAL_SINK=0
# Sandbox only; API version 2025-02-24.acacia. See ENVIRONMENT_SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PORTAL_CONFIG=
